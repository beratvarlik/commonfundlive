# Bu dosyayı .env.local adıyla kopyala ve doldur. .env.local asla paylaşılmaz.

# --- Monad deneme ağı ---
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# --- Yardımcıların sunucu cüzdanları ---
# Sözleşmeyi kurarken contracts/.env içine yazdığın MUHTAR_ADDRESS ve BEKCI_ADDRESS
# bu anahtarlara ait olmalı. İkisi için aynı anahtarı kullanabilirsin.
# Her iki cüzdanda da işlem ücreti için biraz MON olmalı.
MUHTAR_PRIVATE_KEY=
BEKCI_PRIVATE_KEY=

# --- Ücretsiz yapay zekâ modeli (OpenAI uyumlu uç nokta) ---
# Varsayılan: Groq ücretsiz katmanı. Anahtar: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Alternatif (OpenRouter ücretsiz modeller):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Alternatif (Google Gemini ücretsiz katman):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
#
# LLM_API_KEY boş kalırsa yardımcılar kurallı yedek cevaplarla çalışır; demo yine akar.
