# Sözleşmeyi kuracak cüzdanın özel anahtarı (içinde deneme ağı MON'u olmalı)
DEPLOYER_PRIVATE_KEY=

# Muhtar ve Bekçi'nin cüzdan adresleri. Boş bırakırsan kuran cüzdan ikisi için de kullanılır.
# web/.env.local içindeki MUHTAR_PRIVATE_KEY ve BEKCI_PRIVATE_KEY bu adreslere ait olmalı.
MUHTAR_ADDRESS=
BEKCI_ADDRESS=

MONAD_RPC_URL=https://testnet-rpc.monad.xyz
